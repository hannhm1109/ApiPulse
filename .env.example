# Local development only. Replace this URL for a managed PostgreSQL database.
DATABASE_URL="postgresql://apipulse:apipulse@localhost:5433/apipulse"

# Optional: use a separately migrated database for npm run test:db.
# TEST_DATABASE_URL="postgresql://apipulse:apipulse@localhost:5433/apipulse_test"

# Set a random secret of at least 16 characters for the cron HTTP route.
# CRON_SECRET="replace-with-a-random-secret"

# Hosted deployments are read-only by default; never use local mode on a public server.
# APIPULSE_MODE="demo"
# DEMO_BASE_URL="https://your-production-domain.vercel.app"

# For managed PostgreSQL: runtime uses the pooled URL, production setup uses DIRECT_URL.
# Use sslmode=verify-full in both URLs. Never set NEXT_PUBLIC_ database/cron secrets.
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full"
# DATABASE_CONNECTION_MODE="pooled"
